<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.metanet4j</groupId>
        <artifactId>metanet4j-parent</artifactId>
        <version>0.2.0</version>
    </parent>
    <groupId>com.metanet4j</groupId>
    <artifactId>metanet4j-sdk</artifactId>
    <version>0.2.0</version>

    <name>metanet4j-sdk</name>

    <properties>
        <!-- jacoco:check 类级例外（2026-09-28 用户批准，共 12 行）：
             10 个无业务行为的隐式默认构造器 + SigHashExtend 固定内存流不可达的 IOException 包装 2 行。
             清单与理由见任务根目录 unit-coverage-exceptions.json，由 verify-unit.py 严格模式双向核对；
             jacoco:check 的类名是点号 Java 名（内部类写作 Outer.Inner），冒号分隔 -->
        <jacoco.unit.check.excludes>com.metanet4j.sdk.BobHelper:com.metanet4j.sdk.TxoHelper:com.metanet4j.sdk.bap.TaggedDerivation:com.metanet4j.sdk.ordinals.OrdScriptBuilder:com.metanet4j.sdk.ordinals.OrdScriptBuilder.LocalSigner:com.metanet4j.sdk.ordinals.OrdScriptBuilder.RemoteSigner:com.metanet4j.sdk.script.SigHashExtend:com.metanet4j.sdk.utils.TxHelperExtend:com.metanet4j.sdk.utxo.impl.bitails.BitailsClient:com.metanet4j.sdk.utxo.impl.gorillapool.GorillaClient:com.metanet4j.sdk.script.ScriptExtend:com.metanet4j.sdk.bap.BapBase:com.metanet4j.sdk.remote.RemoteOrdTransactionTemplate:com.metanet4j.sdk.remote.RemoteOrdTransactionBuilder:com.metanet4j.sdk.sigma.Sigma:com.metanet4j.sdk.remote.RemoteTransactionSigner:com.metanet4j.sdk.transcation.TransactionBuilder:com.metanet4j.sdk.PrivateKey:com.metanet4j.sdk.signers.OrdinalsTransactionSigner</jacoco.unit.check.excludes>
    </properties>

    <dependencies>

        <!-- 注解：javax.annotation.Nullable/Nonnull 的替代（版本随 Boot BOM 1.0.1） -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.briandilley.jsonrpc4j</groupId>
            <artifactId>jsonrpc4j</artifactId>
        </dependency>


        <dependency>
            <groupId>com.metanet4j</groupId>
            <artifactId>metanet4j-base</artifactId>
            <version>0.2.0</version>
        </dependency>



        <!-- 测试统一 JUnit 5（Jupiter），版本随 Boot BOM -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
